<?xml version="1.0" encoding="utf-8"?>
<!-- ADMX templates created by systmworks - https://github.com/systmworks/TeamViewer-ADMX - License CC BY-SA 4.0 -->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  revision="1.2" schemaVersion="1.0"
  xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="TeamViewer" namespace="TeamViewer.Policies.TeamViewerHost" />
  </policyNamespaces>
  <resources minRequiredRevision="1.2" />
  <supportedOn>
    <definitions>
      <definition displayName="$(string.SupportedTeamViewer)" name="SupportedTeamViewer"/>
    </definitions>
  </supportedOn>

  <categories>
    <category displayName="$(string.TeamViewerCategory)" name="TeamViewerCategory"/>

    <category displayName="$(string.Cat_x64)" name="TeamViewerX64Category">
      <parentCategory ref="TeamViewerCategory"/>
    </category>
    <category displayName="$(string.Cat_x86)" name="TeamViewerX86Category">
      <parentCategory ref="TeamViewerCategory"/>
    </category>

    <category displayName="$(string.Cat_AccessControlIncoming)" name="AccessControlIncomingCategory_x64">
      <parentCategory ref="TeamViewerX64Category"/>
    </category>
    <category displayName="$(string.Cat_AccessControlOutgoing)" name="AccessControlOutgoingCategory_x64">
      <parentCategory ref="TeamViewerX64Category"/>
    </category>
    <category displayName="$(string.Cat_Features)" name="FeaturesCategory_x64">
      <parentCategory ref="TeamViewerX64Category"/>
    </category>
    <category displayName="$(string.Cat_Logging)" name="LoggingCategory_x64">
      <parentCategory ref="TeamViewerX64Category"/>
    </category>
    <category displayName="$(string.Cat_Network)" name="NetworkCategory_x64">
      <parentCategory ref="TeamViewerX64Category"/>
    </category>
    <category displayName="$(string.Cat_Security)" name="SecurityCategory_x64">
      <parentCategory ref="TeamViewerX64Category"/>
    </category>
    <category displayName="$(string.Cat_SessionRecording)" name="SessionRecordingCategory_x64">
      <parentCategory ref="TeamViewerX64Category"/>
    </category>
    <category displayName="$(string.Cat_Updates)" name="UpdatesCategory_x64">
      <parentCategory ref="TeamViewerX64Category"/>
    </category>
    <category displayName="$(string.Cat_WakeOnLAN)" name="WakeOnLANCategory_x64">
      <parentCategory ref="TeamViewerX64Category"/>
    </category>

    <category displayName="$(string.Cat_AccessControlIncoming)" name="AccessControlIncomingCategory_x86">
      <parentCategory ref="TeamViewerX86Category"/>
    </category>
    <category displayName="$(string.Cat_AccessControlOutgoing)" name="AccessControlOutgoingCategory_x86">
      <parentCategory ref="TeamViewerX86Category"/>
    </category>
    <category displayName="$(string.Cat_Features)" name="FeaturesCategory_x86">
      <parentCategory ref="TeamViewerX86Category"/>
    </category>
    <category displayName="$(string.Cat_Logging)" name="LoggingCategory_x86">
      <parentCategory ref="TeamViewerX86Category"/>
    </category>
    <category displayName="$(string.Cat_Network)" name="NetworkCategory_x86">
      <parentCategory ref="TeamViewerX86Category"/>
    </category>
    <category displayName="$(string.Cat_Security)" name="SecurityCategory_x86">
      <parentCategory ref="TeamViewerX86Category"/>
    </category>
    <category displayName="$(string.Cat_SessionRecording)" name="SessionRecordingCategory_x86">
      <parentCategory ref="TeamViewerX86Category"/>
    </category>
    <category displayName="$(string.Cat_Updates)" name="UpdatesCategory_x86">
      <parentCategory ref="TeamViewerX86Category"/>
    </category>
    <category displayName="$(string.Cat_WakeOnLAN)" name="WakeOnLANCategory_x86">
      <parentCategory ref="TeamViewerX86Category"/>
    </category>
  </categories>

  <policies>

    <!-- ======================================== -->
    <!--                                          -->
    <!--    TeamViewer Host (x64) - policies      -->
    <!--                                          -->
    <!-- ======================================== -->

    <!-- ======================================== -->
    <!--        Access Control (Incoming) - x64           -->
    <!-- ======================================== -->

    <!-- Allow Control of Remote TeamViewer -->
    <policy class="Machine" displayName="$(string.AC_Server_ControlRemoteTV)" explainText="$(string.AC_Server_ControlRemoteTV_Explain_x64)" key="SOFTWARE\TeamViewer\AccessControl"
      name="AC_Server_ControlRemoteTV_x64" valueName="AC_Server_Custom_ControlRemoteTV" presentation="$(presentation.AC_Server_ControlRemoteTV_enum_x64)">
      <parentCategory ref="AccessControlIncomingCategory_x64"/>
      <supportedOn ref="SupportedTeamViewer"/>
      <elements>
        <enum id="AC_Server_ControlRemoteTV_enum_x64" valueName="AC_Server_Custom_ControlRemoteTV">
          <item displayName="$(string.AC_Permission_opt0)">
            <value><decimal value="0" /></value>
          </item>
          <item displayName="$(string.AC_Permission_opt1)">
            <value><decimal value="1" /></value>
          </item>
          <item displayName="$(string.AC_Permission_opt2)">
            <value><decimal value="2" /></value>
          </item>
        </enum>
      </elements>
    </policy>

    <!-- Allow Download from File Box -->
    <policy class="Machine" displayName="$(string.AC_Server_DownloadFromFileBox)" explainText="$(string.AC_Server_DownloadFromFileBox_Explain_x64)" key="SOFTWARE\TeamViewer\AccessControl"
