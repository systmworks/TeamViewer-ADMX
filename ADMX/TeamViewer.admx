          <item displayName="$(string.AC_Permission_opt1)">
            <value><decimal value="1" /></value>
          </item>
          <item displayName="$(string.AC_Permission_opt2)">
            <value><decimal value="2" /></value>
          </item>
        </enum>
      </elements>
    </policy>

    <!-- Allow File Transfer (Incoming) -->
    <policy class="Machine" displayName="$(string.AC_Server_FileTransfer)" explainText="$(string.AC_Server_FileTransfer_Explain_x64)" key="SOFTWARE\TeamViewer\AccessControl"
      name="AC_Server_FileTransfer_x64" valueName="AC_Server_Custom_FileTransferAccess" presentation="$(presentation.AC_Server_FileTransfer_enum_x64)">
      <parentCategory ref="AccessControlIncomingCategory_x64"/>
