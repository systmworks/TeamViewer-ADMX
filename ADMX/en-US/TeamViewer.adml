      </presentation>
      <presentation id="AC_Server_RemoteTerminal_enum_x64">
        <dropdownList defaultItem="0" refId="AC_Server_RemoteTerminal_enum_x64">Allow Remote Terminal:</dropdownList>
      </presentation>
      <presentation id="AC_Server_SessionInsightsLogging_enum_x64">
        <dropdownList defaultItem="1" refId="AC_Server_SessionInsightsLogging_enum_x64">Allow Session Insights Logging:</dropdownList>
      </presentation>
      <presentation id="AC_Server_UploadToFileBox_enum_x64">
        <dropdownList defaultItem="0" refId="AC_Server_UploadToFileBox_enum_x64">Allow Upload to File Box:</dropdownList>
      </presentation>
      <presentation id="AC_Server_AllowVPN_enum_x64">
        <dropdownList defaultItem="1" refId="AC_Server_AllowVPN_enum_x64">Allow VPN Connections:</dropdownList>
      </presentation>
      <presentation id="AC_Server_AccessControlType_enum_x64">
