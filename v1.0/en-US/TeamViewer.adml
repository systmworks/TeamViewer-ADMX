<!-- ================================================================= -->
<!--                                                                   -->
<!--    TeamViewer Host — Custom ADML Language File (en-US)            -->
<!--    Created by Darren Milne                                        -->
<!--                                                                   -->
<!--    Supports both x64 and x86 (WOW6432Node) TeamViewer installs   -->
<!--    on 64-bit Windows 10/11.                                       -->
